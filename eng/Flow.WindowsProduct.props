<Project>
  <PropertyGroup>
    <FlowProductId>FlowEngineNet</FlowProductId>
    <FlowProductName>Flow Engine .NET</FlowProductName>
    <FlowProductPublisher>Flow Engine contributors</FlowProductPublisher>
    <FlowProductSupportUrl>https://github.com/MardSilva/FlowEngineNet</FlowProductSupportUrl>
    <FlowPublicVersion Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</FlowPublicVersion>
    <FlowPublicVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</FlowPublicVersion>
    <FlowWindowsInstallerVersion>0.2.3</FlowWindowsInstallerVersion>
    <FlowWindowsUpgradeCode>{C412C622-FA2F-400C-88EE-BA5D4A573F7D}</FlowWindowsUpgradeCode>
    <FlowWindowsRuntimeIdentifier>win-x64</FlowWindowsRuntimeIdentifier>
    <FlowWindowsArchitecture>x64</FlowWindowsArchitecture>
    <FlowWindowsInstallScope>perUser</FlowWindowsInstallScope>
    <FlowWindowsInstallRoot>LocalAppDataFolder</FlowWindowsInstallRoot>
    <FlowWindowsInstallDirectory>Programs\FlowEngineNet</FlowWindowsInstallDirectory>
  </PropertyGroup>

  <ItemGroup>
    <FlowWindowsOwnedComponent Include="ApplicationPayload" />
    <FlowWindowsOwnedComponent Include="CommandAlias" />
    <FlowWindowsOwnedComponent Include="InstallerRegistration" />
    <FlowWindowsOwnedComponent Include="ProductShortcuts" />

    <FlowWindowsPreservedUserData Include="Books" />
    <FlowWindowsPreservedUserData Include="ConfiguredDirectories" />
    <FlowWindowsPreservedUserData Include="FlowDocuments" />
    <FlowWindowsPreservedUserData Include="Preferences" />
    <FlowWindowsPreservedUserData Include="ReportsAndExports" />
  </ItemGroup>
</Project>
