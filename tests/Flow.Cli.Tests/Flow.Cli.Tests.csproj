  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flow.Cli\Flow.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\SampleBook\sample.flow.json"
          Link="SampleBook\sample.flow.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\SampleBook\mobile.html"
          Link="SampleBook\mobile.html"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\SampleBook\desktop.html"
          Link="SampleBook\desktop.html"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
