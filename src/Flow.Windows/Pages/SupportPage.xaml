<Page
    x:Class="Flow.Windows.Pages.SupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource FlowContentBackgroundBrush}">
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
            <VisualState>
                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                <VisualState.Setters><Setter Target="PageContent.Padding" Value="20,24,20,36" /></VisualState.Setters>
            </VisualState>
            <VisualState>
                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="960" /></VisualState.StateTriggers>
                <VisualState.Setters><Setter Target="PageContent.Padding" Value="40,32,40,48" /></VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <ScrollViewer x:Name="PageScrollViewer" HorizontalContentAlignment="Center" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="PageContent" MaxWidth="760" Padding="24,32,24,48" Spacing="16">
            <TextBlock x:Name="TitleText" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="LeadText" TextWrapping="Wrap" />
            <Button x:Name="LoginLink" Click="Login_Click" HorizontalAlignment="Left"
                    Padding="18,12" Margin="0,8,0,12" Background="White" Foreground="Black"
                    BorderBrush="#D8D8D8" CornerRadius="6">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E2E2E2" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="Black" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="Black" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#B8B8B8" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#A8A8A8" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="LoginPrefixText" VerticalAlignment="Center" Foreground="Black" FontWeight="SemiBold" />
                    <Viewbox Width="96" Height="24" Stretch="Uniform">
                        <Canvas Width="1221" Height="300">
                            <Canvas.Clip><RectangleGeometry Rect="0,0,1221,300" /></Canvas.Clip>
                            <Image Source="ms-appx:///Assets/patreon-wordmark.png"
                                   Width="1500" Height="1500" Canvas.Left="-146" Canvas.Top="-600"
                                   AutomationProperties.AccessibilityView="Raw" />
                        </Canvas>
                    </Viewbox>
                </StackPanel>
            </Button>
            <TextBlock x:Name="InstructionsText" TextWrapping="Wrap" />
            <PasswordBox x:Name="KeyInput" MaxLength="128" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ConnectButton" Click="Connect_Click" />
                <Button x:Name="RefreshButton" Click="Refresh_Click" />
                <Button x:Name="DisconnectButton" Click="Disconnect_Click" />
            </StackPanel>
            <ProgressRing x:Name="Progress" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
            <InfoBar x:Name="Message" IsOpen="False" IsClosable="False" />
            <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock x:Name="RecognitionText" TextWrapping="Wrap" FontSize="18" />
            </Border>
            <HyperlinkButton x:Name="ManageLink" NavigateUri="https://mard-cloud.duckdns.org/manage" />
        </StackPanel>
    </ScrollViewer>
</Page>
