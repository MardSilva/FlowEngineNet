<Page
    x:Class="Flow.Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource FlowContentBackgroundBrush}">
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="WidthStates">
            <VisualState x:Name="Compact">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="PageContent.Padding" Value="20,24,20,36" />
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Regular">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="720" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="PageContent.Padding" Value="40,32,40,48" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PageContent" Spacing="24" Padding="40,32,40,48"
                    MaxWidth="900" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock x:Name="TitleText" Style="{ThemeResource TitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Name="LeadText" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Name="LanguageLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="LanguageSelector" MinWidth="260"
                          SelectionChanged="Setting_SelectionChanged">
                    <ComboBoxItem Tag="en-US">English (United States)</ComboBoxItem>
                    <ComboBoxItem Tag="pt-BR">Português (Brasil)</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Name="ThemeLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="ThemeSelector" MinWidth="260"
                          SelectionChanged="Setting_SelectionChanged">
                    <ComboBoxItem x:Name="SystemThemeItem" Tag="System" />
                    <ComboBoxItem x:Name="LightThemeItem" Tag="Light" />
                    <ComboBoxItem x:Name="DarkThemeItem" Tag="Dark" />
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="6">
                <ToggleSwitch x:Name="AdvancedModeToggle" Toggled="Setting_Toggled" />
                <TextBlock x:Name="AdvancedDescription" TextWrapping="Wrap" MaxWidth="620" />
            </StackPanel>
            <InfoBar x:Name="SaveStatus" IsOpen="False" IsClosable="False" Severity="Success" />
        </StackPanel>
    </ScrollViewer>
</Page>
