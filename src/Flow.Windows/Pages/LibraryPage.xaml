<Page
    x:Class="Flow.Windows.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40,32,40,48" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock x:Name="TitleText" Style="{ThemeResource TitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
            <TextBlock x:Name="LeadText" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderPathBox" IsReadOnly="True" />
            <Button x:Name="ChooseFolderButton" Grid.Column="1" Click="ChooseFolderButton_Click" />
            <Button x:Name="RefreshButton" Grid.Column="2" Click="RefreshButton_Click" />
        </Grid>
        <StackPanel Grid.Row="2" x:Name="ProgressPanel" Spacing="6" Visibility="Collapsed">
            <ProgressBar x:Name="ScanProgress" />
            <TextBlock x:Name="ScanStatus" />
        </StackPanel>
        <Grid Grid.Row="3" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="BookList" SelectionChanged="BookList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="6" Spacing="3">
                            <TextBlock Text="{Binding DisplayTitle}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DisplayMetadata}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border Grid.Column="1" x:Name="DetailsCard" Visibility="Collapsed" Padding="20"
                    CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource FlowCardBorderBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <Image x:Name="CoverImage" MaxWidth="180" MaxHeight="270" HorizontalAlignment="Left" Stretch="Uniform" />
                        <TextBlock x:Name="BookTitle" Style="{ThemeResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
                        <TextBlock x:Name="BookMetadata" TextWrapping="Wrap" />
                        <TextBlock x:Name="BookStatus" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="InspectButton" Click="InspectButton_Click" />
                            <Button x:Name="ImportButton" Click="ImportButton_Click" />
                            <Button x:Name="ValidateButton" Click="ValidateButton_Click" />
                            <Button x:Name="PreviewButton" Click="PreviewButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
