<Page
    x:Class="Flow.Windows.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource FlowContentBackgroundBrush}">
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="WidthStates">
            <VisualState x:Name="Compact">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="PageContent.Padding" Value="20,24,20,36" />
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Regular">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="960" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="PageContent.Padding" Value="40,32,40,48" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid x:Name="PageContent" Padding="40,32,40,48" RowSpacing="18"
          MaxWidth="1200" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock x:Name="TitleText" Style="{ThemeResource TitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
            <TextBlock x:Name="LeadText" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
        </StackPanel>
        <Grid x:Name="FolderControlsGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderPathColumn" Width="*" />
                <ColumnDefinition x:Name="ChooseFolderColumn" Width="Auto" />
                <ColumnDefinition x:Name="RefreshColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="FolderActionsRow" Height="0" />
            </Grid.RowDefinitions>
            <TextBox x:Name="FolderPathBox" IsReadOnly="True" />
            <Button x:Name="ChooseFolderButton" Grid.Column="1" Click="ChooseFolderButton_Click" />
            <Button x:Name="RefreshButton" Grid.Column="2" Click="RefreshButton_Click" />
        </Grid>
        <StackPanel Grid.Row="2" x:Name="ProgressPanel" Spacing="6" Visibility="Collapsed">
            <ProgressBar x:Name="ScanProgress" />
            <TextBlock x:Name="ScanStatus" />
        </StackPanel>
        <Grid x:Name="BooksAndDetailsGrid" Grid.Row="3" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BookListColumn" Width="2*" />
                <ColumnDefinition x:Name="BookDetailsColumn" Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="BookListRow" Height="*" />
                <RowDefinition x:Name="BookDetailsRow" Height="0" />
            </Grid.RowDefinitions>
            <ListView x:Name="BookList" SelectionChanged="BookList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="6" Spacing="3">
                            <TextBlock Text="{Binding DisplayTitle}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DisplayMetadata}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border Grid.Column="1" x:Name="DetailsCard" Visibility="Collapsed" Padding="20"
                    CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource FlowCardBorderBrush}"
                    Background="{ThemeResource FlowCardBackgroundBrush}" VerticalAlignment="Top">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Name="BackToBooksButton" Visibility="Collapsed" HorizontalAlignment="Left"
                            Click="BackToBooksButton_Click" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="DetailsContentGrid" ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Image x:Name="CoverImage" Grid.RowSpan="3" MaxWidth="180" MaxHeight="270"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" />
                            <TextBlock x:Name="BookTitle" Grid.Column="1" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
                            <TextBlock x:Name="BookMetadata" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                            <TextBlock x:Name="BookStatus" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                        </Grid>
                    </ScrollViewer>
                    <Grid x:Name="DetailsActionsGrid" Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button x:Name="InspectButton" HorizontalAlignment="Stretch" Click="InspectButton_Click" />
                        <Button x:Name="ImportButton" Grid.Column="1" HorizontalAlignment="Stretch"
                                Click="ImportButton_Click" />
                        <Button x:Name="ValidateButton" Grid.Row="1" HorizontalAlignment="Stretch"
                                Click="ValidateButton_Click" />
                        <Button x:Name="PreviewButton" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                Click="PreviewButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
