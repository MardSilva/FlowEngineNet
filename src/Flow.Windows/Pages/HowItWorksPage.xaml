<Page
    x:Class="Flow.Windows.Pages.HowItWorksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource FlowContentBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="ConceptCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource FlowCardBorderBrush}" />
            <Setter Property="Background" Value="{ThemeResource FlowCardBackgroundBrush}" />
        </Style>
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
        <Style x:Key="CardHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
        </Style>
    </Page.Resources>
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="WidthStates">
            <VisualState x:Name="Compact">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="PageContent.Padding" Value="20,24,20,36" />
                    <Setter Target="SectionNavigation.Visibility" Value="Collapsed" />
                    <Setter Target="CompactSectionPicker.Visibility" Value="Visible" />
                    <Setter Target="SectionNavigationColumn.Width" Value="0" />
                    <Setter Target="SectionBodyGrid.ColumnSpacing" Value="0" />
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Regular">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="960" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="PageContent.Padding" Value="40,32,40,48" />
                    <Setter Target="SectionNavigation.Visibility" Value="Visible" />
                    <Setter Target="CompactSectionPicker.Visibility" Value="Collapsed" />
                    <Setter Target="SectionNavigationColumn.Width" Value="220" />
                    <Setter Target="SectionBodyGrid.ColumnSpacing" Value="28" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid x:Name="PageContent" Padding="40,32,40,48" RowSpacing="18"
          MaxWidth="1200" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock x:Name="TitleText" Style="{ThemeResource TitleTextBlockStyle}"
                       TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="LeadText" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
        </StackPanel>

        <ComboBox x:Name="CompactSectionPicker" Grid.Row="1" Visibility="Collapsed"
                  HorizontalAlignment="Stretch" SelectionChanged="CompactSectionPicker_SelectionChanged" />

        <Grid x:Name="SectionBodyGrid" Grid.Row="2" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SectionNavigationColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="SectionNavigation" Spacing="8" VerticalAlignment="Top">
                <TextBlock x:Name="OnThisPageText" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ListView x:Name="SectionList" SelectionMode="Single"
                          SelectionChanged="SectionList_SelectionChanged"
                          AutomationProperties.Name="Sections">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="40" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </StackPanel>

            <ScrollViewer x:Name="SectionScrollViewer" Grid.Column="1"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="SectionContent" MaxWidth="820" HorizontalAlignment="Left">
                    <StackPanel x:Name="OverviewSection" Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="OverviewTitle" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock x:Name="OverviewText" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Padding="24" CornerRadius="10" BorderThickness="2"
                                BorderBrush="{ThemeResource FlowAccentBrush}"
                                Background="{ThemeResource FlowCardBackgroundBrush}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock x:Name="InvariantText" Style="{ThemeResource SubtitleTextBlockStyle}"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="Level3" />
                                <TextBlock x:Name="InvariantExplanation" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="700" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ConceptCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="OverviewResultTitle" Style="{StaticResource CardHeadingStyle}" />
                                <TextBlock x:Name="OverviewResultText" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ResponsibilitiesSection" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ResponsibilitiesTitle" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock x:Name="ResponsibilitiesText" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Style="{StaticResource ConceptCardStyle}">
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="DocumentTitle" Style="{StaticResource CardHeadingStyle}" />
                                <TextBlock x:Name="DocumentDescription" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ConceptCardStyle}">
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="LayoutTitle" Style="{StaticResource CardHeadingStyle}" />
                                <TextBlock x:Name="LayoutDescription" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ConceptCardStyle}">
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="RenderingTitle" Style="{StaticResource CardHeadingStyle}" />
                                <TextBlock x:Name="RenderingDescription" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ResponsibilitiesNote" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="IdentitySection" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="IdentityTitle" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock x:Name="IdentityText" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Style="{StaticResource ConceptCardStyle}">
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="HashChangesTitle" Style="{StaticResource CardHeadingStyle}" />
                                <TextBlock x:Name="HashChangesText" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ConceptCardStyle}">
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="HashStableTitle" Style="{StaticResource CardHeadingStyle}" />
                                <TextBlock x:Name="HashStableText" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="IdentityNote" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="PipelineSection" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="PipelineTitle" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock x:Name="PipelineText" TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsControl x:Name="PipelineItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ConceptCardStyle}" Margin="0,0,0,10">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardHeadingStyle}" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="FormatsSection" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="FormatsTitle" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock x:Name="FormatsText" TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsControl x:Name="FormatItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ConceptCardStyle}" Margin="0,0,0,10">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardHeadingStyle}" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="SafetySection" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="SafetyTitle" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock x:Name="SafetyText" TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsControl x:Name="SafetyItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ConceptCardStyle}" Margin="0,0,0,10">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardHeadingStyle}" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="ResearchSection" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ResearchTitle" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock x:Name="ResearchText" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Style="{StaticResource ConceptCardStyle}">
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="AvailableTitle" Style="{StaticResource CardHeadingStyle}" />
                                <TextBlock x:Name="AvailableText" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ConceptCardStyle}">
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="FutureTitle" Style="{StaticResource CardHeadingStyle}" />
                                <TextBlock x:Name="FutureText" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ResearchNote" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="FaqSection" Spacing="12" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="FaqTitle" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock x:Name="FaqText" TextWrapping="Wrap" />
                        </StackPanel>
                        <Expander x:Name="FaqEpub" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="FaqEpubAnswer" TextWrapping="Wrap" Margin="0,4,0,12" />
                        </Expander>
                        <Expander x:Name="FaqAppearance" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="FaqAppearanceAnswer" TextWrapping="Wrap" Margin="0,4,0,12" />
                        </Expander>
                        <Expander x:Name="FaqLoss" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="FaqLossAnswer" TextWrapping="Wrap" Margin="0,4,0,12" />
                        </Expander>
                        <Expander x:Name="FaqReader" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="FaqReaderAnswer" TextWrapping="Wrap" Margin="0,4,0,12" />
                        </Expander>
                        <Expander x:Name="FaqOffline" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="FaqOfflineAnswer" TextWrapping="Wrap" Margin="0,4,0,12" />
                        </Expander>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
